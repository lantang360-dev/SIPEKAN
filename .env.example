# ============================================
# SIPEKAN - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# DATABASE (Required)
# For local development with SQLite:
DATABASE_URL="file:./db/custom.db"

# For Vercel deployment with Turso (SQLite-compatible):
# DATABASE_URL="file:data.db"
# Or using Turso libSQL URL:
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"

# APPLICATION (Optional)
# NODE_ENV is auto-set by Vercel, set manually for local:
# NODE_ENV="production"

# TTS Configuration (Optional - for announcement sounds)
# Requires z-ai-web-dev-sdk
