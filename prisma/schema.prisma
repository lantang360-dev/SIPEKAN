generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// PETUGAS (Staff/Officer)
// ============================================
model Petugas {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  nama      String
  nip       String   @unique
  jabatan   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications     Verification[]
  callHistory       QueueCall[]
  verifiedRegistrations Registration[] @relation("RegistrationVerifier")

  @@map("petugas")
}

// ============================================
// LAYANAN (Service Types)
// ============================================
model Layanan {
  id          String @id @default(cuid())
  kode        String @unique
  nama        String
  deskripsi   String
  prefix      String
  estimasi    String
  isActive    Boolean @default(true)
  urutan      Int      @default(0)

  counters     Counter[]
  registrations Registration[]
  queueTickets QueueTicket[]

  @@map("layanan")
}

// ============================================
// COUNTER (Service Counter/Loket)
// ============================================
model Counter {
  id          String   @id @default(cuid())
  nomor       Int
  nama        String
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  layananId   String
  layanan     Layanan @relation(fields: [layananId], references: [id])
  calls       QueueCall[]
  dailySessions DailySession[]

  @@unique([nomor])
  @@map("counter")
}

// ============================================
// PENDAFTARAN (Visitor Registration)
// ============================================
model Registration {
  id                  String   @id @default(cuid())
  nomorRegistrasi     String   @unique
  tanggalDaftar       DateTime @default(now())
  tanggalBesukan      DateTime
  status              String   @default("menunggu")
  catatanPetugas      String?

  namaLengkap         String
  nik                 String
  tempatLahir         String
  tanggalLahir        DateTime
  jenisKelamin        String
  pekerjaan           String
  alamat              String
  nomorHP             String
  email               String?

  namaWargaBinaan     String
  nomorRegistrasiWB   String?
  hubungan            String
  tujuan              String
  jumlahPengunjung    Int
  catatan             String?

  dokKTP              Boolean  @default(false)
  dokKK               Boolean  @default(false)
  dokSuratDesa        Boolean  @default(false)
  dokIzinKhusus       Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  layananId           String
  layanan             Layanan @relation(fields: [layananId], references: [id])

  verifiedBy          String?
  verifiedByPetugas   Petugas? @relation("RegistrationVerifier", fields: [verifiedBy], references: [id])
  verifications       Verification[]
  notifikasi          Notifikasi[]

  @@index([status])
  @@index([namaLengkap])
  @@index([nomorRegistrasi])
  @@index([nik])
  @@index([namaWargaBinaan])
  @@index([tanggalBesukan])
  @@map("registration")
}

// ============================================
// VERIFICATION (Audit trail)
// ============================================
model Verification {
  id            String   @id @default(cuid())
  registrationId String
  registration  Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  petugasId     String
  petugas       Petugas @relation(fields: [petugasId], references: [id])
  action        String
  catatan       String?
  createdAt     DateTime @default(now())

  @@index([registrationId])
  @@index([petugasId])
  @@map("verification")
}

// ============================================
// QUEUE TICKET
// ============================================
model QueueTicket {
  id              String   @id @default(cuid())
  nomorAntrian    String
  tanggal         DateTime @default(now())
  waktuAmbil      DateTime @default(now())
  status          String   @default("menunggu")

  layananId       String
  layanan         Layanan @relation(fields: [layananId], references: [id])

  callId          String?  @unique
  calledBy        QueueCall? @relation(fields: [callId], references: [id])

  dipanggilPada   DateTime?
  selesaiPada     DateTime?
  dipanggilDi     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([nomorAntrian, tanggal])
  @@index([status])
  @@index([layananId])
  @@index([tanggal])
  @@map("queue_ticket")
}

// ============================================
// QUEUE CALL (Counter Call History)
// ============================================
model QueueCall {
  id              String   @id @default(cuid())
  nomorAntrian    String
  waktu           DateTime @default(now())

  counterId       String
  counter         Counter @relation(fields: [counterId], references: [id])

  petugasId       String
  petugas         Petugas @relation(fields: [petugasId], references: [id])

  ticket          QueueTicket?

  @@index([counterId])
  @@index([petugasId])
  @@index([waktu])
  @@map("queue_call")
}

// ============================================
// DAILY SESSION
// ============================================
model DailySession {
  id              String   @id @default(cuid())
  tanggal         DateTime
  counterId       String
  counter         Counter @relation(fields: [counterId], references: [id])
  currentNumber   Int      @default(0)
  totalCalled     Int      @default(0)
  totalMenunggu   Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tanggal, counterId])
  @@index([tanggal])
  @@map("daily_session")
}

// ============================================
// NOTIFIKASI WA (WhatsApp Notification Log)
// ============================================
model Notifikasi {
  id              String   @id @default(cuid())
  registrationId  String
  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  nomorHP         String
  tipe            String
  statusKirim     String   @default("pending")
  pesan           String
  providerResponse String?
  sentAt          DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([registrationId])
  @@index([statusKirim])
  @@index([nomorHP])
  @@map("notifikasi")
}

// ============================================
// PENGATURAN (System Settings)
// ============================================
model Pengaturan {
  id        String @id @default(cuid())
  key       String @unique
  value     String
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pengaturan")
}
